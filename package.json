{
  "name": "gitmate",
  "displayName": "GitMate",
  "description": "A git sidekick for VS Code: chat with your model in the sidebar, generate commit messages, and create branches. Works with Anthropic, OpenAI, OpenRouter, Groq, Ollama, LM Studio, and more.",
  "version": "1.0.2",
  "publisher": "SmartClouds",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmate",
          "title": "GitMate",
          "icon": "resources/gitmate.svg"
        }
      ]
    },
    "views": {
      "gitmate": [
        {
          "id": "gitmate.chatView",
          "name": "GitMate",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "gitmate.generateCommitMessage",
        "title": "Generate Commit Message with GitMate",
        "icon": {
          "light": "resources/commit-light.svg",
          "dark": "resources/commit-dark.svg"
        }
      },
      {
        "command": "gitmate.createBranch",
        "title": "Create Branch with GitMate",
        "icon": {
          "light": "resources/branch-light.svg",
          "dark": "resources/branch-dark.svg"
        }
      },
      {
        "command": "gitmate.openChat",
        "title": "GitMate: Open Chat"
      },
      {
        "command": "gitmate.newChat",
        "title": "GitMate: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "gitmate.openSettings",
        "title": "GitMate: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitmate.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "gitmate.createBranch",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "gitmate.newChat",
          "group": "navigation",
          "when": "view == gitmate.chatView"
        },
        {
          "command": "gitmate.openSettings",
          "group": "navigation",
          "when": "view == gitmate.chatView"
        }
      ],
      "commandPalette": [
        {
          "command": "gitmate.generateCommitMessage",
          "when": "scmProvider == git || gitOpenRepositoryCount != 0"
        },
        {
          "command": "gitmate.createBranch",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "gitmate.openChat"
        },
        {
          "command": "gitmate.newChat"
        },
        {
          "command": "gitmate.openSettings"
        }
      ]
    },
    "configuration": {
      "title": "GitMate",
      "properties": {
        "gitmate.activeProvider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "openrouter",
            "groq",
            "together",
            "deepseek",
            "mistral",
            "gemini",
            "lmstudio",
            "ollama",
            "custom"
          ],
          "enumDescriptions": [
            "Anthropic Claude (cloud)",
            "OpenAI (cloud)",
            "OpenRouter (cloud)",
            "Groq (cloud)",
            "Together AI (cloud)",
            "DeepSeek (cloud)",
            "Mistral (cloud)",
            "Google Gemini (cloud)",
            "LM Studio (local)",
            "Ollama (local)",
            "Custom OpenAI-compatible"
          ],
          "default": "anthropic",
          "markdownDescription": "Active LLM provider. Pick a provider and set its model, base URL, and key visually in the GitMate sidebar (**GitMate: Open Settings**)."
        },
        "gitmate.providers": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-provider model and base URL. Blank entries fall back to sensible defaults. API keys are stored securely in SecretStorage, not here. Managed in the GitMate sidebar."
        },
        "gitmate.commitMessageInstructions": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "",
          "description": "Optional extra guidance added on top of GitMate's built-in commit prompt, which already follows Conventional Commits. Use this for house rules, like a required scope or a ticket reference."
        },
        "gitmate.maxDiffBytes": {
          "type": "number",
          "default": 100000,
          "description": "Maximum size of the diff (in bytes) sent to the model. Larger diffs are truncated with a warning."
        },
        "gitmate.requestTimeoutMs": {
          "type": "number",
          "default": 60000,
          "markdownDescription": "Default time to wait (in milliseconds) for a model request before giving up. Helpful when a local model is slow to load or stops responding. Set to `0` to wait indefinitely. While a chat reply is streaming this acts as a connection timeout, so long answers are not cut off. Each provider can override this from the GitMate settings panel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
